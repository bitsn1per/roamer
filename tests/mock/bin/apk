#!/bin/sh
# like apk v3: wpad-basic-* also *provides* "hostapd" and "wpa-supplicant" (a virtual match for `info -e`)
# `info -s` prints sizes the way apk does (MOCK_NO_SIZES=1: says nothing); MOCK_UPDATE_FAIL=1: no internet
db="$MOCK_STATE/apk.installed"
case "$1" in
  info) case "$2" in
          -e) grep -qx "$3" "$db" && exit 0
              case "$3" in hostapd|wpa-supplicant) grep -q '^wpad' "$db";; *) exit 1;; esac ;;
          -s) [ "${MOCK_NO_SIZES:-0}" != 1 ] || exit 1
              printf '%s-1.0-r1 installed size:\n100 KiB\n\n' "$3" ;;
          *)  exit 1 ;;
        esac ;;
  list) sed 's/$/-2025.08.26-r1 x86_64 {hostapd} (BSD) [installed]/' "$db" ;;
  search) echo "$2-1.0-r1" ;;
  update) [ "${MOCK_UPDATE_FAIL:-0}" != 1 ] ;;
  add) shift; exec "$(dirname "$0")/mock-pkg" atomic "$@" ;;
  del) shift; for p; do grep -vx "$p" "$db" > "$db.n"; mv "$db.n" "$db"; done ;;
esac
